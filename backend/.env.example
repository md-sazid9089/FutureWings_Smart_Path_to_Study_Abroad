# Frontend origins (comma-separated)
FRONTEND_URL=http://localhost:3000,https://future-wings-smart-path-to-study-ab.vercel.app/

# Database
DATABASE_URL="mysql://USER:PASS@HOST:PORT/DATABASE"

# Auth
JWT_SECRET=your_jwt_secret_here

# Stripe (secrets should be set in Vercel, do NOT commit real keys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLIC_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Server
PORT=5000
NODE_ENV=development

# AI Provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_CHAT_MAX_OUTPUT_TOKENS=1800
