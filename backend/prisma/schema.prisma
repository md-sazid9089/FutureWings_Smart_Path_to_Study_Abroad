generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int             @id @default(autoincrement())
  email               String          @unique @db.VarChar(191)
  passwordHash        String          @db.VarChar(191)
  role                String          @default("USER") @db.VarChar(10)
  fullName            String?         @db.VarChar(191)
  cgpa                Float?
  degreeLevel         String?         @db.VarChar(50)
  major               String?         @db.VarChar(100)
  fundScore           Int?
  createdAt           DateTime        @default(now())
  profileHeadline     String?         @db.VarChar(120)
  isPremium           Boolean         @default(false)
  premiumFeatures     String?         @db.VarChar(100)
  premiumExpiryDate   DateTime?
  stripeCustomerId    String?         @db.VarChar(191)
  applications        Application[]
  countryRatings      CountryRating[]
  documents           UserDocument[]
  payments            Payment[]
  notifications       Notification[]

  @@map("Users")
}

model Country {
  id             Int             @id @default(autoincrement())
  countryName    String          @db.VarChar(191)
  region         String?         @db.VarChar(100)
  currency       String?         @db.VarChar(20)
  tierLevel      Int             @default(3)
  isActive       Boolean         @default(true)
  visaFeeNote    String?         @db.VarChar(100)
  applications   Application[]
  countryRatings CountryRating[]
  scholarships   Scholarship[]
  universities   University[]

  @@map("Countries")
}

model University {
  id             Int       @id @default(autoincrement())
  countryId      Int
  universityName String    @db.VarChar(191)
  type           String?   @db.VarChar(50)
  city           String?   @db.VarChar(100)
  programs       Program[]
  country        Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@map("Universities")
}

model Program {
  id              Int           @id @default(autoincrement())
  universityId    Int
  programName     String        @db.VarChar(191)
  level           String?       @db.VarChar(50)
  tuitionPerYear  Float?
  durationMonths  Int?
  intakeSeasons   String?       @db.VarChar(100)
  programOverview String?       @db.LongText
  applications    Application[]
  university      University    @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@map("Programs")
}

model Scholarship {
  id                  Int       @id @default(autoincrement())
  countryId           Int
  scholarshipName     String    @db.VarChar(191)
  eligibilityCriteria String?   @db.VarChar(500)
  applyLink           String?   @db.VarChar(500)
  deadline            DateTime?
  amount              Float?
  country             Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@map("Scholarships")
}

model UserDocument {
  id                 Int      @id @default(autoincrement())
  userId             Int
  filePath           String   @db.VarChar(500)
  fileType           String?  @db.VarChar(50)
  verificationStatus String   @default("PENDING") @db.VarChar(20)
  adminNote          String?  @db.VarChar(500)
  uploadedAt         DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("UserDocuments")
}

model ApplicationStatus {
  id           Int           @id @default(autoincrement())
  statusName   String        @unique @db.VarChar(191)
  applications Application[]

  @@map("ApplicationStatuses")
}

model Application {
  id             Int               @id @default(autoincrement())
  userId         Int
  countryId      Int
  programId      Int
  statusId       Int
  appliedDate    DateTime          @default(now())
  intakeApplied  String?           @db.VarChar(50)
  country        Country           @relation(fields: [countryId], references: [id], onDelete: Cascade)
  program        Program           @relation(fields: [programId], references: [id], onDelete: Cascade)
  status         ApplicationStatus @relation(fields: [statusId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryRatings CountryRating[]
  visaOutcome    VisaOutcome?

  @@index([userId, statusId])
  @@index([countryId])
  @@index([programId])
  @@index([statusId])
  @@map("Applications")
}

model VisaOutcome {
  id              Int         @id @default(autoincrement())
  applicationId   Int         @unique
  decision        String      @db.VarChar(20)
  reasonTitle     String?     @db.VarChar(191)
  notes           String?     @db.LongText
  destinationDate DateTime?
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("VisaOutcomes")
}

model CountryRating {
  id            Int         @id @default(autoincrement())
  userId        Int
  countryId     Int
  applicationId Int
  ratingValue   Int
  comments      String?     @db.LongText
  ratingType    String      @default("POST") @db.VarChar(10)
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  country       Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, countryId, ratingType])
  @@index([countryId])
  @@map("CountryRatings")
}

model Payment {
  id                Int       @id @default(autoincrement())
  userId            Int
  stripeSessionId   String    @db.VarChar(191)
  stripePaymentId   String?   @db.VarChar(191)
  amount            Int
  currency          String    @default("USD") @db.VarChar(10)
  featureType       String    @db.VarChar(50)
  status            String    @default("PENDING") @db.VarChar(20)
  createdAt         DateTime  @default(now())
  completedAt       DateTime?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSessionId])
  @@map("Payments")
}

model VisaConsultancy {
  id                Int       @id @default(autoincrement())
  agencyName        String    @db.VarChar(191)
  email             String?   @db.VarChar(191)
  phone             String?   @db.VarChar(20)
  country           String?   @db.VarChar(100)
  city              String?   @db.VarChar(100)
  website           String?   @db.VarChar(500)
  description       String?   @db.LongText
  specializations   String?   @db.VarChar(500)
  rating            Float?    @default(0.0)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("VisaConsultancies")
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String    @db.VarChar(50)
  title     String    @db.VarChar(191)
  message   String    @db.VarChar(500)
  read      Boolean   @default(false)
  link      String?   @db.VarChar(500)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
  @@map("Notifications")
}
